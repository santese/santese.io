---
import BaseLayout from './BaseLayout.astro';
import type { Note } from '../lib/collection';
import { formatDate, toISODate } from '../lib/notes';

interface Props {
  note: Note;
}

const { note } = Astro.props;
const { title, description, publishedAt, updatedAt, tags, draft } = note.data;
---

<BaseLayout title={title} description={description} ogType="article" noindex={draft}>
  <article>
    <header class="note-header">
      {draft && <p class="draft">Draft: visible in local development only</p>}
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={toISODate(publishedAt)}>{formatDate(publishedAt)}</time>
        {updatedAt && (
          <span>
            {' '}
            · Updated <time datetime={toISODate(updatedAt)}>{formatDate(updatedAt)}</time>
          </span>
        )}
        {tags.length > 0 && <span> · {tags.join(', ')}</span>}
      </p>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
  <p class="back">
    <a href="/notes/">All notes</a>
  </p>
</BaseLayout>

<style>
  .note-header {
    margin-bottom: var(--space-8);
  }

  .note-header h1 {
    margin-bottom: var(--space-2);
  }

  .meta {
    margin: 0;
  }

  .draft {
    margin: 0 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-accent);
  }

  .back {
    margin-top: var(--space-12);
    font-size: var(--text-sm);
  }
</style>
