---
import BaseLayout from '../layouts/BaseLayout.astro';
import NoteList from '../components/NoteList.astro';
import { site } from '../data/site';
import { homelab } from '../data/homelab';
import { getPublishedNotes } from '../lib/collection';

const recentNotes = (await getPublishedNotes()).slice(0, 3);
---

<BaseLayout>
  <section aria-labelledby="intro-heading">
    <h1 id="intro-heading">
      Hey, I'm Santese<span class="punct">.</span>
    </h1>
    <p class="lede">
      I work across software engineering, IT infrastructure, and security. I like building tools
      that automate tedious work and make systems easier to manage.
    </p>
    <p>
      Lately, I've been building <a href={site.featuredProject.href}>{site.featuredProject.name}</a>
      , a device management and automation platform for macOS and Windows.
    </p>
  </section>

  {recentNotes.length > 0 && (
    <section aria-labelledby="notes-heading">
      <h2 id="notes-heading">Recent notes</h2>
      <NoteList notes={recentNotes} headingLevel="h3" />
      <p class="more">
        <a href="/notes/">All notes</a>
      </p>
    </section>
  )}

  <section aria-labelledby="homelab-heading">
    <h2 id="homelab-heading">Homelab</h2>
    <p>{homelab.intro}</p>
    <p class="more">
      <a href="/homelab/">What's in the homelab</a>
    </p>
  </section>

  {site.social.length > 0 && (
    <section aria-labelledby="elsewhere-heading">
      <h2 id="elsewhere-heading">Elsewhere</h2>
      <p>
        {site.social.map((link, i) => (
          <>
            {i > 0 && ' · '}
            <a href={link.href} rel="me">
              {link.label}
            </a>
          </>
        ))}
      </p>
    </section>
  )}
</BaseLayout>

<style>
  /* Echoes the purple square in the logo. Used only here. */
  .punct {
    color: var(--color-accent);
  }

  .more {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
  }
</style>
